[Unit]
Description=AntDelirium protected governance service
Requires=antdelirium-agent.socket antdelirium-admin.socket
After=antdelirium-agent.socket antdelirium-admin.socket
After=local-fs.target

[Service]
Type=simple
ExecStart=@LIBEXECDIR@/antdelirium service
User=antdelirium
Group=antdelirium
NoNewPrivileges=yes
UMask=0077
LimitCORE=0
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
KeyringMode=private
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
StateDirectory=antdelirium
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
