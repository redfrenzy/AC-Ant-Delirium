{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:legacy-stage-receipt-v1",
  "title": "AntDelirium protected legacy staging receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "migration_id",
    "project_id",
    "source_snapshot_sha256",
    "staging_snapshot_sha256",
    "entries",
    "regular_files",
    "directories",
    "staged_bytes",
    "state"
  ],
  "properties": {
    "contract_version": { "const": "legacy-stage-receipt-v1" },
    "migration_id": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "staging_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "entries": { "$ref": "#/$defs/count" },
    "regular_files": { "$ref": "#/$defs/count" },
    "directories": { "$ref": "#/$defs/count" },
    "staged_bytes": { "$ref": "#/$defs/count" },
    "state": { "const": "staged" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 }
  }
}
