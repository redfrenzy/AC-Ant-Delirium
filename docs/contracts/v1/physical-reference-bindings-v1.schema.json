{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:physical-reference-bindings-v1",
  "title": "AntDelirium protected physical reference bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "migration_id", "project_id", "bindings"],
  "properties": {
    "contract_version": { "const": "physical-reference-bindings-v1" },
    "migration_id": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "bindings": {
      "type": "array",
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_value_sha256", "reference_id"],
        "properties": {
          "source_value_sha256": { "$ref": "#/$defs/sha256" },
          "reference_id": { "type": "string", "pattern": "^ref_[0-9a-hjkmnp-tv-z]{26}$" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
