{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:governance-task-package-receipt-v1",
  "title": "AntDelirium generic governance task package receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "project_id",
    "workspace_id",
    "plan_id",
    "current_task_id",
    "state_revision",
    "task_count",
    "audit_sequence",
    "state"
  ],
  "properties": {
    "contract_version": { "const": "governance-task-package-receipt-v1" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "workspace_id": { "type": "string", "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$" },
    "plan_id": { "type": "string", "pattern": "^pln_[0-9a-hjkmnp-tv-z]{26}$" },
    "current_task_id": { "type": "string", "pattern": "^tsk_[0-9a-hjkmnp-tv-z]{26}$" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "task_count": { "type": "integer", "minimum": 1, "maximum": 256 },
    "audit_sequence": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["installed", "already-installed"] }
  }
}
