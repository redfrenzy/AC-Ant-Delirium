{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:capability-grant-receipt-v1",
  "title": "AntDelirium managed capability grant receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "capability_id", "audit_sequence", "event_id",
    "correlation_id", "state"
  ],
  "properties": {
    "contract_version": { "const": "capability-grant-receipt-v1" },
    "capability_id": { "type": "string", "pattern": "^cap_[0-9a-hjkmnp-tv-z]{26}$" },
    "audit_sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^evt_[0-9a-hjkmnp-tv-z]{26}$" },
    "correlation_id": { "type": "string", "pattern": "^ref_[0-9a-hjkmnp-tv-z]{26}$" },
    "state": { "const": "active" }
  }
}
