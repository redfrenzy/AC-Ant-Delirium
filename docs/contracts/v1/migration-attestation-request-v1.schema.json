{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:migration-attestation-request-v1",
  "title": "Migration verifier attestation request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "migration_id", "project_id", "workspace_id", "expected_conversion_report_sha256"],
  "properties": {
    "contract_version": { "const": "migration-attestation-request-v1" },
    "migration_id": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "workspace_id": { "type": "string", "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$" },
    "expected_conversion_report_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
