{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:admin-protocol-v1",
  "title": "AntDelirium administrative protocol v1",
  "oneOf": [
    { "$ref": "#/$defs/clientHello" },
    { "$ref": "#/$defs/serverHello" },
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/response" }
  ],
  "$defs": {
    "nonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "requestId": { "type": "string", "pattern": "^req_[0-9a-hjkmnp-tv-z]{26}$" },
    "capabilityId": { "type": "string", "pattern": "^cap_[0-9a-hjkmnp-tv-z]{26}$" },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "token"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/capabilityId" },
        "token": { "$ref": "#/$defs/nonce" }
      }
    },
    "clientHello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_type", "channel", "wire_versions", "client_nonce"],
      "properties": {
        "message_type": { "const": "client_hello" },
        "channel": { "const": "admin" },
        "wire_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 32 }
        },
        "client_nonce": { "$ref": "#/$defs/nonce" }
      }
    },
    "serverHello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_type", "wire_version", "connection_nonce", "max_frame_bytes"],
      "properties": {
        "message_type": { "const": "server_hello" },
        "wire_version": { "const": "ada/1" },
        "connection_nonce": { "$ref": "#/$defs/nonce" },
        "max_frame_bytes": { "const": 4194304 }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_type", "wire_version", "request_id", "connection_nonce", "operation", "capability", "body"],
      "properties": {
        "message_type": { "const": "request" },
        "wire_version": { "const": "ada/1" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "connection_nonce": { "$ref": "#/$defs/nonce" },
        "operation": { "enum": ["capability.grant", "capability.revoke", "governance.task-package.prepare", "governance.task-package.inspect", "governance.task-package.attest", "governance.task-package.approve", "governance.task-package.install", "governance.task.advance.accepted", "migration.stage", "migration.normalize", "migration.dry-run", "migration.convert", "migration.attest", "migration.approve", "migration.cutover", "migration.identity-associate"] },
        "capability": { "$ref": "#/$defs/capability" },
        "body": {
          "oneOf": [
            { "$ref": "urn:antdelirium:contract:migration-identity-association-v1" },
            { "$ref": "urn:antdelirium:contract:capability-grant-request-v1" },
            { "$ref": "urn:antdelirium:contract:capability-revoke-request-v1" },
            { "$ref": "urn:antdelirium:contract:governance-task-package-v1" },
            { "$ref": "urn:antdelirium:contract:governance-task-package-v2" },
            { "$ref": "urn:antdelirium:contract:task-generation-source-v1" },
            { "$ref": "#/$defs/taskPackageInspect" },
            { "$ref": "urn:antdelirium:contract:task-package-attestation-v1" },
            { "$ref": "urn:antdelirium:contract:task-package-approval-v1" },
            { "$ref": "urn:antdelirium:contract:governance-task-advance-v1" },
            { "$ref": "#/$defs/migrationStageBody" },
            { "$ref": "urn:antdelirium:contract:legacy-normalization-request-v1" },
            { "$ref": "urn:antdelirium:contract:legacy-dry-run-request-v1" },
            { "$ref": "urn:antdelirium:contract:legacy-conversion-request-v1" },
            { "$ref": "urn:antdelirium:contract:migration-attestation-request-v1" },
            { "$ref": "urn:antdelirium:contract:migration-approval-request-v1" },
            { "$ref": "urn:antdelirium:contract:migration-cutover-request-v1" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "migration.identity-associate" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:migration-identity-association-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "governance.task-package.prepare" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:task-generation-source-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "governance.task-package.inspect" } } },
          "then": { "properties": { "body": { "$ref": "#/$defs/taskPackageInspect" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "governance.task-package.attest" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:task-package-attestation-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "governance.task-package.approve" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:task-package-approval-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "capability.grant" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:capability-grant-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "capability.revoke" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:capability-revoke-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "governance.task-package.install" } } },
          "then": { "properties": { "body": { "oneOf": [
            { "$ref": "urn:antdelirium:contract:governance-task-package-v1" },
            { "$ref": "urn:antdelirium:contract:governance-task-package-v2" }
          ] } } }
        },
        {
          "if": { "properties": { "operation": { "const": "governance.task.advance.accepted" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:governance-task-advance-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.stage" } } },
          "then": { "properties": { "body": { "$ref": "#/$defs/migrationStageBody" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.normalize" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:legacy-normalization-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.dry-run" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:legacy-dry-run-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.convert" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:legacy-conversion-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.attest" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:migration-attestation-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.approve" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:migration-approval-request-v1" } } }
        },
        {
          "if": { "properties": { "operation": { "const": "migration.cutover" } } },
          "then": { "properties": { "body": { "$ref": "urn:antdelirium:contract:migration-cutover-request-v1" } } }
        }
      ]
    },
    "taskPackageInspect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "request_id", "project_id", "workspace_id", "expected_state_revision", "proposal_id"],
      "properties": {
        "contract_version": { "const": "task-package-inspect-v1" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
        "workspace_id": { "type": "string", "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$" },
        "expected_state_revision": { "type": "integer", "minimum": 0 },
        "proposal_id": { "type": "string", "pattern": "^prp_[0-9a-hjkmnp-tv-z]{26}$" }
      }
    },
    "taskPackageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receipt", "proposal"],
      "properties": {
        "receipt": { "$ref": "urn:antdelirium:contract:task-package-operation-receipt-v1" },
        "proposal": { "$ref": "urn:antdelirium:contract:task-package-proposal-v1" }
      }
    },
    "migrationStageBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_source_snapshot_sha256", "inventory"],
      "properties": {
        "expected_source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "inventory": { "$ref": "urn:antdelirium:contract:legacy-source-inventory-v1" }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message_type", "wire_version", "request_id", "status", "result", "error"],
      "properties": {
        "message_type": { "const": "response" },
        "wire_version": { "const": "ada/1" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "status": { "enum": ["ok", "error"] },
        "result": {
          "oneOf": [
            { "$ref": "urn:antdelirium:contract:capability-grant-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:capability-revoke-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:governance-task-package-receipt-v1" },
            { "$ref": "#/$defs/taskPackageArtifact" },
            { "$ref": "urn:antdelirium:contract:task-package-operation-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:migration-identity-association-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:governance-task-advance-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:legacy-stage-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:legacy-normalization-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:legacy-dry-run-report-v1" },
            { "$ref": "urn:antdelirium:contract:legacy-conversion-report-v1" },
            { "$ref": "urn:antdelirium:contract:migration-attestation-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:migration-approval-receipt-v1" },
            { "$ref": "urn:antdelirium:contract:migration-cutover-receipt-v1" },
            { "type": "null" }
          ]
        },
        "error": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["code", "category", "retryable", "message", "action", "correlation_id"],
              "properties": {
                "code": {
                  "enum": [
                    "AD-USAGE-0001",
                    "AD-CODE-0001",
                    "AD-SERVICE-0001",
                    "AD-INTERNAL-0001",
                    "AD-TEMP-0001",
                    "AD-PROTOCOL-0001",
                    "AD-AUTH-0001",
                    "AD-CONFIG-0001",
                    "AD-TOOLCHAIN-0001",
                    "AD-TOOLCHAIN-0002"
                  ]
                },
                "category": {
                  "enum": [
                    "usage_error",
                    "code_violation",
                    "service_unavailable",
                    "tool_internal_error",
                    "temporary_failure",
                    "protocol_error",
                    "authorization_error",
                    "governance_configuration_error",
                    "toolchain_execution_error"
                  ]
                },
                "retryable": { "type": "boolean" },
                "message": { "type": "string", "maxLength": 1024 },
                "action": {
                  "enum": ["read_task_projection", "read_governance_projection", "retry", "fix_invocation", "contact_operator", "none"]
                },
                "correlation_id": {
                  "oneOf": [
                    { "type": "string", "pattern": "^ref_[0-9a-hjkmnp-tv-z]{26}$" },
                    { "type": "null" }
                  ]
                }
              }
            }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": {
            "properties": {
              "result": {
                "oneOf": [
                  { "$ref": "urn:antdelirium:contract:capability-grant-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:capability-revoke-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:governance-task-package-receipt-v1" },
                  { "$ref": "#/$defs/taskPackageArtifact" },
                  { "$ref": "urn:antdelirium:contract:task-package-operation-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:migration-identity-association-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:governance-task-advance-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:legacy-stage-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:legacy-normalization-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:legacy-dry-run-report-v1" },
                  { "$ref": "urn:antdelirium:contract:legacy-conversion-report-v1" },
                  { "$ref": "urn:antdelirium:contract:migration-attestation-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:migration-approval-receipt-v1" },
                  { "$ref": "urn:antdelirium:contract:migration-cutover-receipt-v1" }
                ]
              },
              "error": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "result": { "type": "null" },
              "error": { "type": "object" }
            }
          }
        }
      ]
    },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
