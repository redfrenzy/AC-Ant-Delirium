{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:migration-cutover-request-v1",
  "title": "Canonical migration cutover request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "migration_id", "project_id", "workspace_id",
    "expected_approved_manifest_sha256", "expected_source_snapshot_sha256",
    "expected_staging_snapshot_sha256", "expected_conversion_report_sha256",
    "attestation_id", "expected_attestation_sha256", "approval_id",
    "expected_approval_sha256", "expected_candidate_logical_state_sha256",
    "rollback_legacy_snapshot_sha256", "rollback_window_seconds"
  ],
  "properties": {
    "contract_version": { "const": "migration-cutover-request-v1" },
    "migration_id": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "workspace_id": { "type": "string", "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$" },
    "expected_approved_manifest_sha256": { "$ref": "#/$defs/sha256" },
    "expected_source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "expected_staging_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "expected_conversion_report_sha256": { "$ref": "#/$defs/sha256" },
    "attestation_id": { "type": "string", "pattern": "^att_[0-9a-hjkmnp-tv-z]{26}$" },
    "expected_attestation_sha256": { "$ref": "#/$defs/sha256" },
    "approval_id": { "type": "string", "pattern": "^apr_[0-9a-hjkmnp-tv-z]{26}$" },
    "expected_approval_sha256": { "$ref": "#/$defs/sha256" },
    "expected_candidate_logical_state_sha256": { "$ref": "#/$defs/sha256" },
    "rollback_legacy_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "rollback_window_seconds": { "type": "integer", "minimum": 2592000, "maximum": 316224000 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
