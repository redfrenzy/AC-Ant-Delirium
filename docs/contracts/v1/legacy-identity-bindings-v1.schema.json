{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:legacy-identity-bindings-v1",
  "title": "Protected legacy identity bindings v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "migration_id", "project_id", "workspace_id", "plans", "tasks"],
  "properties": {
    "contract_version": { "const": "legacy-identity-bindings-v1" },
    "migration_id": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "workspace_id": { "type": "string", "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$" },
    "plans": { "type": "array", "items": { "$ref": "#/$defs/planBinding" } },
    "tasks": { "type": "array", "items": { "$ref": "#/$defs/taskBinding" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_key_sha256", "canonical_id"],
      "properties": {
        "source_key_sha256": { "$ref": "#/$defs/sha256" },
        "canonical_id": { "type": "string" }
      }
    },
    "planBinding": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "properties": { "canonical_id": { "pattern": "^pln_[0-9a-hjkmnp-tv-z]{26}$" } } }
      ]
    },
    "taskBinding": {
      "allOf": [
        { "$ref": "#/$defs/binding" },
        { "properties": { "canonical_id": { "pattern": "^tsk_[0-9a-hjkmnp-tv-z]{26}$" } } }
      ]
    }
  }
}
