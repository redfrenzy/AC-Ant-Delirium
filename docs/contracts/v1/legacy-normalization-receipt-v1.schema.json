{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:legacy-normalization-receipt-v1",
  "title": "AntDelirium protected legacy normalization receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "migration_id",
    "project_id",
    "source_snapshot_sha256",
    "staging_snapshot_sha256",
    "normalized_snapshot_sha256",
    "semantic_snapshot_sha256",
    "entries_compared",
    "regular_files_compared",
    "json_documents_compared",
    "physical_references",
    "physical_occurrences",
    "comparison",
    "state"
  ],
  "properties": {
    "contract_version": { "const": "legacy-normalization-receipt-v1" },
    "migration_id": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "project_id": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "staging_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "normalized_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "semantic_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "entries_compared": { "$ref": "#/$defs/count" },
    "regular_files_compared": { "$ref": "#/$defs/count" },
    "json_documents_compared": { "$ref": "#/$defs/count" },
    "physical_references": { "$ref": "#/$defs/count" },
    "physical_occurrences": { "$ref": "#/$defs/count" },
    "comparison": { "const": "equivalent" },
    "state": { "const": "normalized" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 }
  }
}
