{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antdelirium:contract:migration-approval-request-v1",
  "title": "Operator migration approval request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "migration_id", "project_id", "workspace_id",
    "expected_manifest_snapshot_sha256", "expected_source_snapshot_sha256",
    "expected_staging_snapshot_sha256", "expected_conversion_report_sha256",
    "attestation_id", "expected_attestation_sha256",
    "expected_candidate_logical_state_sha256", "rollback_legacy_snapshot_sha256"
  ],
  "properties": {
    "contract_version": { "const": "migration-approval-request-v1" },
    "migration_id": { "$ref": "#/$defs/migrationId" },
    "project_id": { "$ref": "#/$defs/projectId" },
    "workspace_id": { "$ref": "#/$defs/workspaceId" },
    "expected_manifest_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "expected_source_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "expected_staging_snapshot_sha256": { "$ref": "#/$defs/sha256" },
    "expected_conversion_report_sha256": { "$ref": "#/$defs/sha256" },
    "attestation_id": { "$ref": "#/$defs/attestationId" },
    "expected_attestation_sha256": { "$ref": "#/$defs/sha256" },
    "expected_candidate_logical_state_sha256": { "$ref": "#/$defs/sha256" },
    "rollback_legacy_snapshot_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "migrationId": { "type": "string", "pattern": "^mig_[0-9a-hjkmnp-tv-z]{26}$" },
    "projectId": { "type": "string", "pattern": "^prj_[0-9a-hjkmnp-tv-z]{26}$" },
    "workspaceId": { "type": "string", "pattern": "^wsp_[0-9a-hjkmnp-tv-z]{26}$" },
    "attestationId": { "type": "string", "pattern": "^att_[0-9a-hjkmnp-tv-z]{26}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
