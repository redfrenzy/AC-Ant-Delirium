{
  "version": "2.1.0",
  "$schema": "https://schemastore.azurewebsites.net/schemas/json/sarif-2.1.0-rtm.4.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ac_ant_delirium",
          "version": "0.1.0"
        }
      },
      "properties": {
        "governance": {
          "terminal_report": "/home/dracker/Antigravity Projects/playground/aesthetic_core_project/ac_ant_delirium/src/Logs/artifacts/governance_terminal.log",
          "violations_manifest": "/home/dracker/Antigravity Projects/playground/aesthetic_core_project/ac_ant_delirium/src/Logs/artifacts/violations_manifest.json",
          "priority_order": "P0 → P1 → P2 → P3 → P4",
          "total_violations": 0,
          "audited_files": 0,
          "audited_file_paths": [
          ],
          "context": [
            "Each .rs file has a companion *_manifest.json with technical symbols.",
            "Read *_manifest.json before editing the source code.",
            "Shadow Context includes exact line references for each violation.",
            "P0 violations are critical and should be fixed first."
          ],
          "tools": [
            "Shadow Context 2.1.0 — Machine-readable violation report",
            "Technical manifests — *_manifest.json per scanned source file"
          ],
          "terminal_commands": [
            "cargo check --target x86_64-unknown-linux-gnu",
            "cargo test --target x86_64-unknown-linux-gnu",
            "ac_ant_delirium --api hierarchy.help",
            "ac_ant_delirium --api hierarchy.installation"
          ],
          "applied_config": {
            "max_nesting": 3,
            "max_params": 4,
            "logical_density": 34,
            "restricted_tokens": [
              "panic!",
              "unwrap"
            ],
            "allowed_crates": [
              "ac_ant_delirium"
            ]
          },
          "summary": {
            "total": 0,
            "p0": 0,
            "p1": 0,
            "p2": 0,
            "p3": 0,
            "p4": 0
          }
        }
      },
      "results": [
      ]
    }
  ]
}