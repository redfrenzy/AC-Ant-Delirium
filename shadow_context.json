        "applied_config": {
          "max_lines": 0,
          "max_nesting": 0,
          "max_params": 0,
          "logical_density": 0,
          "restricted_tokens": ["print", "unwrap", "panic"],
          "allowed_crates": ["std", "core", "alloc"]
        }
      }
